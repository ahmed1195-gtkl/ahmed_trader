# ═══════════════════════════════════════════════════════════════
# Ahmed Trader - Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Firebase Configuration
# ───────────────────────────────────────────────────────────────
# Get these from Firebase Console > Project Settings > General
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ───────────────────────────────────────────────────────────────
# Market Data APIs
# ───────────────────────────────────────────────────────────────

# Finnhub API - Real-time stock and forex data
# Get your API key from: https://finnhub.io/
# Free tier: 60 API calls/minute
VITE_FINNHUB_API_KEY=your_finnhub_api_key_here

# TwelveData API - Historical and real-time market data
# Get your API key from: https://twelvedata.com/
# Free tier: 800 API calls/day
VITE_TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# ───────────────────────────────────────────────────────────────
# MetaTrader Integration
# ───────────────────────────────────────────────────────────────

# MetaAPI - MT4/MT5 Integration
# Get your token from: https://metaapi.cloud/
# Free tier: 1 demo account
VITE_METAAPI_TOKEN=your_metaapi_token_here

# ───────────────────────────────────────────────────────────────
# Security & Encryption
# ───────────────────────────────────────────────────────────────

# Encryption Key for sensitive data (investor passwords, etc.)
# IMPORTANT: Generate a strong random key (32+ characters)
# Example: openssl rand -base64 32
VITE_ENCRYPTION_KEY=your_strong_encryption_key_here_minimum_32_characters

# ───────────────────────────────────────────────────────────────
# Optional: News & Analysis APIs
# ───────────────────────────────────────────────────────────────

# News API - Financial news and sentiment analysis
# Get your API key from: https://newsapi.org/
# VITE_NEWS_API_KEY=your_news_api_key_here

# Alpha Vantage - Technical indicators and fundamental data
# Get your API key from: https://www.alphavantage.co/
# VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# ───────────────────────────────────────────────────────────────
# Optional: Cloud Storage
# ───────────────────────────────────────────────────────────────

# Cloudinary - Image and video storage
# Get your credentials from: https://cloudinary.com/
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
# VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ───────────────────────────────────────────────────────────────
# Optional: Notifications
# ───────────────────────────────────────────────────────────────

# Telegram Bot - For notifications and alerts
# Get your bot token from: https://t.me/BotFather
# VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id

# ───────────────────────────────────────────────────────────────
# Development Settings
# ───────────────────────────────────────────────────────────────

# Enable debug mode (true/false)
# VITE_DEBUG_MODE=false

# API Request Timeout (milliseconds)
# VITE_API_TIMEOUT=30000

# ═══════════════════════════════════════════════════════════════
# End of Configuration
# ═══════════════════════════════════════════════════════════════
