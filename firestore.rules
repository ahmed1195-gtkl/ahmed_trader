rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // وظيفة للتحقق مما إذا كان المستخدم هو أدمن
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'mchokri100@gmail.com' || 
        request.auth.token.email == 'ahmed1195@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // وظيفة للتحقق مما إذا كان المستخدم مسجل دخول
    function isSignedIn() {
      return request.auth != null;
    }

    // قواعد مجموعة المستخدمين
    match /users/{userId} {
      // القراءة: متاحة لجميع المستخدمين المسجلين
      allow read: if isSignedIn();
      
      // الإنشاء: المستخدم يمكنه إنشاء ملفه الشخصي فقط
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // التحديث: الأدمن أو المستخدم نفسه
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      
      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // قواعد صفقات البوت (Bot Trades)
    match /bot_trades/{tradeId} {
      allow read: if true;
      allow create: if true; 
      allow update, delete: if isAdmin();
    }

    // قواعد إعدادات وأوزان البوت (Bot Settings)
    match /bot_settings/{settingId} {
      allow read: if true;
      allow write: if true; 
    }

    // قواعد المنشورات (Posts)
    match /posts/{postId} {
      // القراءة: متاحة للجميع
      allow read: if true;
      
      // الإنشاء: الأدمن فقط
      allow create: if isAdmin();
      
      // التحديث: متاح للمستخدمين المسجلين (للإعجابات والتعليقات)
      allow update: if isSignedIn();
      
      // الحذف: الأدمن فقط
      allow delete: if isAdmin();
    }

    // قواعد منشورات الأدمن (Admin Posts) - للتوافق مع الإصدارات القديمة
    match /admin_posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // قواعد التعليقات (Comments)
    match /comments/{commentId} {
      // القراءة: متاحة للجميع
      allow read: if true;
      
      // الإنشاء: متاح للمستخدمين المسجلين
      allow create: if isSignedIn();
      
      // التحديث والحذف: الأدمن أو صاحب التعليق
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // قواعد الرسائل القديمة (Messages) - للتوافق مع الإصدارات القديمة
    match /messages/{messageId} {
      // القراءة: الأدمن يرى جميع الرسائل، المستخدم يرى رسائله فقط
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // الإنشاء: متاح لأي مستخدم مسجل
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // التحديث والحذف: الأدمن فقط
      allow update, delete: if isAdmin();
    }

    // قواعد المحادثات الجديدة (Conversations)
    match /conversations/{conversationId} {
      // القراءة: الأدمن أو المشاركين في المحادثة
      allow read: if isAdmin() || 
                     (isSignedIn() && request.auth.uid in resource.data.participants);
      
      // الإنشاء: المستخدم المسجل يمكنه إنشاء محادثة إذا كان أحد المشاركين
      allow create: if isSignedIn() && 
                       request.auth.uid in request.resource.data.participants;
      
      // التحديث: المشاركين في المحادثة (لتحديث آخر رسالة)
      allow update: if isSignedIn() && 
                       request.auth.uid in resource.data.participants;
      
      // الحذف: الأدمن فقط
      allow delete: if isAdmin();

      // قواعد الرسائل داخل المحادثة
      match /messages/{messageId} {
        // القراءة: الأدمن أو المشاركين في المحادثة
        allow read: if isAdmin() || 
                       (isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
        
        // الإنشاء: المشاركين في المحادثة فقط
        allow create: if isSignedIn() && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid;
        
        // التحديث: ممنوع (الرسائل لا تُعدل)
        allow update: if false;
        
        // الحذف: الأدمن أو مرسل الرسالة
        allow delete: if isAdmin() || 
                         (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    // قواعد إعدادات الموقع (Site Settings)
    match /site_settings/{settingId} {
      // القراءة: متاحة للجميع المسجلين
      allow read: if isSignedIn();
      
      // الكتابة: الأدمن فقط
      allow write: if isAdmin();
    }

    // قواعد سجل النشاط (Activity Logs)
    match /activity_logs/{logId} {
      // القراءة: الأدمن فقط
      allow read: if isAdmin();
      
      // الإنشاء: الأدمن فقط
      allow create: if isAdmin();
      
      // التحديث والحذف: ممنوع (السجلات لا تُعدل)
      allow update, delete: if false;
    }

    // قواعد الوسطاء (Brokers)
    match /brokers/{brokerId} {
      // القراءة: متاحة للجميع
      allow read: if true;
      
      // الكتابة: الأدمن فقط
      allow write: if isAdmin();
    }

    // قواعد طلبات الصداقة (Friend Requests)
    match /friend_requests/{requestId} {
      // القراءة: المستخدم يرى الطلبات المرسلة منه أو إليه
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
      
      // الإنشاء: المستخدم يمكنه إرسال طلب صداقة
      allow create: if isSignedIn() && 
                       request.resource.data.senderId == request.auth.uid;
      
      // التحديث: المستقبل يمكنه قبول الطلب
      allow update: if isSignedIn() && 
                       resource.data.receiverId == request.auth.uid;
      
      // الحذف: المرسل أو المستقبل يمكنهما حذف الطلب
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid || 
        resource.data.receiverId == request.auth.uid
      );
    }
  }
}
